generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ─── Business (tenant root) ───────────────────────────────────────────────────
// Every piece of data belongs to a Business. One Business can have many Users
// (owner + team members). All queries must filter by businessId for isolation.

model Business {
  id          String   @id @default(cuid())
  name        String
  plan        String   @default("free")   // free | pro | enterprise
  ownerId     String                       // userId of the account owner
  logoUrl     String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users             User[]
  contacts          Contact[]
  projects          Project[]
  services          Service[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  recurringExpenses RecurringExpense[]
  notifications     Notification[]
  tasks             Task[]
  teamMembers       TeamMember[]
  timeEntries       TimeEntry[]
  bookings          Booking[]
  availabilityRules AvailabilityRule[]
  proposals         Proposal[]
  contracts         Contract[]
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  password      String
  plan          String         @default("free")
  role          String         @default("owner")   // owner | member
  companyName     String?
  companyLogo     String?
  timezone        String         @default("UTC")
  currency        String         @default("USD")
  paymentMethods    String         @default("card")
  stripeAccountId   String?
  stripeOnboarded   Boolean        @default(false)
  createdAt         DateTime       @default(now())

  // Multi-tenancy — nullable during onboarding; set once business is created/joined
  businessId    String?
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)

  // Legacy per-user relations kept for backwards compatibility during migration
  @@index([businessId])

  projects      Project[]
  contacts      Contact[]
  services      Service[]
  expenses      Expense[]
  expenseCategories ExpenseCategory[]
  recurringExpenses RecurringExpense[]
  notifications Notification[]
  tasks             Task[]
  teamMembers       TeamMember[]
  timeEntries       TimeEntry[]
  bookings          Booking[]
  availabilityRules AvailabilityRule[]
  proposals     Proposal[]
  contracts     Contract[]
  pdfTemplates  PdfTemplate[]
}

// ─── Contact ──────────────────────────────────────────────────────────────────

model Contact {
  id            String    @id @default(cuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  entityType    String    @default("individual")
  jobTitle      String?
  email         String?
  phone         String?
  website       String?
  company       String?
  companyAddressLine1 String?
  companyCity   String?
  companyState  String?
  companyPostalCode String?
  companyCountry String?
  status        String    @default("lead")  // lead | active | archived
  source        String?
  value         Float?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]

  @@index([userId])
  @@index([businessId])
}

// ─── Project ──────────────────────────────────────────────────────────────────

model Project {
  id           String    @id @default(cuid())
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id])
  title        String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("in_progress")
  stage        String    @default("kickoff")
  portalToken  String    @unique
  archived     Boolean   @default(false)
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  files        File[]
  comments     Comment[]
  notes        Note[]
  invoices     Invoice[]
  expenses     Expense[]
  recurringExpenses RecurringExpense[]
  tasks       Task[]
  timeEntries TimeEntry[]
  proposals   Proposal[]
  contracts   Contract[]

  @@index([userId])
  @@index([businessId])
}

// ─── File ─────────────────────────────────────────────────────────────────────
// Scoped through Project → businessId (no direct businessId needed)

model File {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  path       String
  sizeBytes  Int      @default(0)
  mimeType   String?
  label      String?
  uploadedBy      String   @default("freelancer")
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// ─── Comment ──────────────────────────────────────────────────────────────────
// Scoped through Project → businessId

model Comment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorName String
  authorType String
  body       String
  createdAt  DateTime @default(now())
}

// ─── Note ─────────────────────────────────────────────────────────────────────
// Scoped through Project → businessId

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  title     String?
  body      String
  pinned          Boolean  @default(false)
  visibleToClient Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Invoice ──────────────────────────────────────────────────────────────────
// Scoped through Project → businessId

model Invoice {
  id                    String        @id @default(cuid())
  projectId             String
  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber         String?
  lineItems             String        // JSON array
  subtotal              Float         @default(0)
  taxRate               Float         @default(0)
  taxAmount             Float         @default(0)
  discountType          String        @default("none")
  discountValue         Float         @default(0)
  discountAmount        Float         @default(0)
  total                 Float
  currency              String        @default("USD")
  dueDate               DateTime?
  notes                 String?
  status                String        @default("draft")
  remindersEnabled      Boolean       @default(true)
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  sentAt                DateTime?
  paidAt                DateTime?
  paymentPlans          PaymentPlan[]
}

// ─── PaymentPlan ──────────────────────────────────────────────────────────────
// Scoped through Invoice → Project → businessId

model PaymentPlan {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String?
  amount    Float
  dueDate   DateTime?
  status    String    @default("upcoming")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Service ──────────────────────────────────────────────────────────────────

model Service {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  defaultRate Float     @default(0)
  unit        String    @default("flat")
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([businessId])
}

// ─── Expense ──────────────────────────────────────────────────────────────────

model Expense {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  description String
  note        String?
  amount      Float
  category    String    @default("other")
  date        DateTime  @default(now())
  receipt     String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([businessId])
}

// ─── ExpenseCategory ──────────────────────────────────────────────────────────

model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@index([businessId])
}

// ─── RecurringExpense ─────────────────────────────────────────────────────────

model RecurringExpense {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  description String
  note        String?
  amount      Float
  category    String    @default("other")
  frequency   String    @default("monthly")
  nextDate    DateTime
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]

  @@index([userId])
  @@index([businessId])
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  read       Boolean   @default(false)
  link       String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([businessId])
}

// ─── Task ─────────────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  businessId  String?
  business    Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeMemberId String?
  assigneeMember   TeamMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  title       String
  description String?
  subtasks    String?
  status      String     @default("todo")
  priority    String     @default("medium")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([businessId])
}

// ─── TeamMember ───────────────────────────────────────────────────────────────

model TeamMember {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  role        String    @default("collaborator")
  permissions String    @default("assign_tasks")
  status      String    @default("pending")
  inviteToken String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@unique([userId, email])
  @@index([userId])
  @@index([businessId])
}

// ─── TimeEntry ────────────────────────────────────────────────────────────────

model TimeEntry {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  duration    Int       @default(0)
  billable    Boolean   @default(true)
  hourlyRate  Float     @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([businessId])
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  clientEmail String
  startAt     DateTime
  endAt       DateTime
  title       String
  notes       String?
  status      String    @default("confirmed")
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([businessId])
}

// ─── AvailabilityRule ─────────────────────────────────────────────────────────

model AvailabilityRule {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String

  @@index([userId])
  @@index([businessId])
}

// ─── Proposal ─────────────────────────────────────────────────────────────────

model Proposal {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  clientName  String
  clientEmail String?
  intro       String?
  sections    String
  pricing     String
  total       Float     @default(0)
  currency    String    @default("USD")
  validUntil     DateTime?
  status         String    @default("draft")
  sentAt         DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([businessId])
}

// ─── PdfTemplate ──────────────────────────────────────────────────────────────

model PdfTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "invoice" | "proposal" | "contract"
  name        String
  isDefault   Boolean  @default(false)

  // General
  paperSize    String   @default("A4")
  orientation  String   @default("portrait")
  marginTop    Float    @default(0.4)
  marginBottom Float    @default(0.4)
  marginLeft   Float    @default(0.4)
  marginRight  Float    @default(0.4)

  // Branding
  accentColor       String  @default("#18181b")
  logoUrl           String?
  showLogo          Boolean @default(true)
  businessName      String?
  businessAddress   String?
  businessEmail     String?
  businessPhone     String?

  // Typography
  fontFamily String @default("helvetica")
  fontSize   Int    @default(10)

  // Header & Footer
  headerStyle     String  @default("classic")
  footerText      String?
  showPageNumbers Boolean @default(true)

  // Table
  tableHeaderBg        String  @default("#18181b")
  tableHeaderTextColor String  @default("#ffffff")
  showItemNumbers      Boolean @default(true)
  showTaxColumn        Boolean @default(false)

  // Content
  showWatermark       Boolean @default(false)
  showTerms           Boolean @default(false)
  termsText           String?
  showSignatureBlock  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
}

// ─── Contract ─────────────────────────────────────────────────────────────────

model Contract {
  id            String    @id @default(cuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  clientName    String
  clientEmail   String?
  clauses       String
  status        String    @default("draft")
  sentAt        DateTime?
  signedAt      DateTime?
  signatureName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([businessId])
}
