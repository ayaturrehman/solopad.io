{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "solopad.io" }],
      "destination": "https://www.solopad.io/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-invoices",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/invoice-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
